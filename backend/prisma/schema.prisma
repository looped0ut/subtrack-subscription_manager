generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SOFTWARE
  ADDON
  SERVICE
  OTHER
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED // value = amount in paise
  PERCENTAGE // value = basis points (1000 = 10%)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

// ============================ PEOPLE ============================

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  resetTokenHash    String? // hashed password-reset token (never store the raw token)
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer             Customer?
  subscriptionsCreated Subscription[] @relation("SubscriptionCreatedBy")
  paymentsRecorded     Payment[]      @relation("PaymentRecordedBy")

  @@index([role])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  // Optional link to a login account (set when the customer gets portal access)
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([name])
  @@index([email])
}

// ============================ CATALOG ============================

model Tax {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  rateBps   Int // basis points: 1800 = 18%
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subscriptionLines      SubscriptionLine[]
  quotationTemplateLines QuotationTemplateLine[]
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  type       ProductType @default(SOFTWARE)
  salesPrice Int // paise
  costPrice  Int // paise
  notes      String?
  isActive   Boolean     @default(true) // "delete" = deactivate when product is already used
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  variants               ProductVariant[]
  planProducts           PlanProduct[]
  subscriptionLines      SubscriptionLine[]
  quotationTemplateLines QuotationTemplateLine[]
  invoiceLines           InvoiceLine[]
  discountProducts       DiscountProduct[]

  @@index([name])
  @@index([isActive])
}

// A variant is an attribute of a product, e.g. "Brand"
model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String

  options VariantOption[]

  @@unique([productId, name])
}

// An option inside a variant, e.g. "Odoo" with extraPrice 56000 paise (= 560.00)
model VariantOption {
  id         Int            @id @default(autoincrement())
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value      String
  extraPrice Int            @default(0) // paise added to the product base price

  subscriptionLines      SubscriptionLine[]
  quotationTemplateLines QuotationTemplateLine[]

  @@unique([variantId, value])
}

model Plan {
  id                Int              @id @default(autoincrement())
  name              String           @unique
  billingFrequency  BillingFrequency
  minQuantity       Int              @default(1)
  availableFrom     DateTime         @db.Date
  availableTo       DateTime?        @db.Date
  // Renewal / closure / pause configuration
  autoRenew         Boolean          @default(false)
  allowEarlyClosure Boolean          @default(false)
  allowPause        Boolean          @default(false)
  maxPauseDays      Int?
  autoCloseOnExpiry Boolean          @default(true)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  planProducts           PlanProduct[]
  subscriptions          Subscription[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([isActive])
}

model PlanProduct {
  planId    Int
  productId Int
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([planId, productId])
}

model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  validityDays Int      @default(30)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines         QuotationTemplateLine[]
  subscriptions Subscription[]
}

model QuotationTemplateLine {
  id              Int               @id @default(autoincrement())
  templateId      Int
  template        QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product           @relation(fields: [productId], references: [id])
  planId          Int
  plan            Plan              @relation(fields: [planId], references: [id])
  variantOptionId Int?
  variantOption   VariantOption?    @relation(fields: [variantOptionId], references: [id])
  taxId           Int?
  tax             Tax?              @relation(fields: [taxId], references: [id])
  quantity        Int               @default(1)
  unitPrice       Int // paise (base price + variant extra at template time)

  @@index([templateId])
}

// ============================ SUBSCRIPTIONS ============================

model Subscription {
  id                  Int                @id @default(autoincrement())
  number              String             @unique // e.g. SUB-000001
  customerId          Int
  customer            Customer           @relation(fields: [customerId], references: [id])
  planId              Int
  plan                Plan               @relation(fields: [planId], references: [id])
  templateId          Int?
  template            QuotationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @db.Date
  expiryDate          DateTime           @db.Date
  paymentTermsDays    Int                @default(15) // invoice due N days after issue
  nextBillingDate     DateTime?          @db.Date
  quotationValidUntil DateTime?          @db.Date
  pausedAt            DateTime?
  closedAt            DateTime?
  closedReason        String?
  totalAmount         Int                @default(0) // paise per billing cycle
  notes               String?
  createdById         Int?
  createdBy           User?              @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lines     SubscriptionLine[]
  invoices  Invoice[]
  discounts DiscountSubscription[]

  @@index([status])
  @@index([customerId])
  @@index([expiryDate])
  @@index([status, nextBillingDate]) // used by the billing job
  @@index([createdAt])
}

model SubscriptionLine {
  id              Int            @id @default(autoincrement())
  subscriptionId  Int
  subscription    Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product        @relation(fields: [productId], references: [id])
  variantOptionId Int?
  variantOption   VariantOption? @relation(fields: [variantOptionId], references: [id])
  taxId           Int?
  tax             Tax?           @relation(fields: [taxId], references: [id])
  taxRateBps      Int            @default(0) // copy of the tax rate when the line was saved
  quantity        Int
  unitPrice       Int // paise, includes variant extra price

  @@index([subscriptionId])
}

// ============================ INVOICING ============================

model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique // e.g. INV-000001
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])
  subscriptionId Int
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Int           @default(0)
  taxTotal       Int           @default(0)
  discountTotal  Int           @default(0)
  total          Int           @default(0)
  amountPaid     Int           @default(0)
  sentAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines     InvoiceLine[]
  payments  Payment[]
  discounts InvoiceDiscount[]

  // DUPLICATE BILLING PREVENTION: one invoice per subscription per billing period
  @@unique([subscriptionId, periodStart])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate]) // outstanding / overdue queries
  @@index([customerId])
  @@index([createdAt])
}

model InvoiceLine {
  id           Int      @id @default(autoincrement())
  invoiceId    Int
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description  String
  quantity     Int
  unitPrice    Int // paise
  taxRateBps   Int      @default(0)
  lineSubtotal Int // quantity * unitPrice
  taxAmount    Int      @default(0)

  @@index([invoiceId])
}

// ============================ DISCOUNTS ============================

model Discount {
  id                Int          @id @default(autoincrement())
  name              String
  code              String?      @unique
  type              DiscountType
  value             Int // FIXED = paise, PERCENTAGE = basis points
  minPurchaseAmount Int          @default(0) // paise
  minQuantity       Int          @default(0)
  startDate         DateTime     @db.Date
  endDate           DateTime?    @db.Date
  maxUsage          Int? // null = unlimited
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // If both lists below are empty, the discount applies to everything.
  products      DiscountProduct[]
  subscriptions DiscountSubscription[]
  usages        InvoiceDiscount[]

  @@index([isActive, startDate, endDate])
}

model DiscountProduct {
  discountId Int
  productId  Int
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
}

model DiscountSubscription {
  discountId     Int
  subscriptionId Int
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@id([discountId, subscriptionId])
}

// Records that a discount was applied to an invoice (also stops double-applying)
model InvoiceDiscount {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountId Int
  discount   Discount @relation(fields: [discountId], references: [id])
  amount     Int // paise taken off

  @@unique([invoiceId, discountId])
}

// ============================ PAYMENTS ============================

model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Int // paise
  method       PaymentMethod
  paidAt       DateTime      @default(now())
  reference    String?
  notes        String?
  recordedById Int?
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

// ============================ NUMBERING ============================

// Safe counters for SUB-000001 / INV-000001 style numbers
model Sequence {
  name  String @id // "subscription", "invoice"
  value Int    @default(0)
}
